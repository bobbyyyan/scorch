+inline double* scorch_probe_walls() { static double w[256 * 5]; return w; }
+inline long& scorch_probe_ncalls() { static long n = 0; return n; }
+inline double scorch_probe_now() {
+  return (double)std::chrono::duration_cast<std::chrono::nanoseconds>(
