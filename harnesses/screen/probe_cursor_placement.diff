+    }, py::arg("steal"), py::arg("trace"), py::arg("cmode") = 0);
+    m.def("probe_dump", []() {
+      std::vector<std::vector<double>> out;
+      const long n = std::min(scorch_probe_ncalls(), 256L);
+      for (long c = 0; c < n; ++c) {
+        const double* w = scorch_probe_walls() + c * 5;
+        out.push_back({-1.0, (double)c, w[0], w[1], w[2], w[3], w[4], 0, 0});
+        for (int t = 0; t < (int)w[1] && t < 64; ++t) {
+          const ScorchProbeRec& r = scorch_probe_recs()[c * 64 + t];
+          out.push_back({(double)t, (double)c, r.t_entry, r.t_own, r.t_exit, (double)r.rows_own,
+                         (double)r.rows_stolen, (double)r.steals, (double)r.scanned});
+        }
+      }
+      return out;
+    });
     m.def("scorch_spmm_chunk", &scorch_spmm_chunk,
