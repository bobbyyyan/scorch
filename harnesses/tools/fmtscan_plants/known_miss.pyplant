# KNOWN MISSES: a specifier DOES reach output here and the scan cannot see it. These are the costs
# the docstring states, kept as a corpus rather than as prose so each one is asserted to be a real
# miss and not a hypothetical. Silence has TWO causes -- correct code, and an undetectable defect --
# and a single corpus conflating them cannot assert either.
#
# Two earlier members LEFT this file because they were misses only through an inconsistency rather
# than through a limit: an argument to .format() and a value argument to lazy logging are both
# substituted verbatim, exactly as the right operand of % is, and that one was already flagged.
# A documented cost has to be a limit of the method, not a gap in it.
import logging
log = logging.getLogger("x")
tbl = {}
keeps, new = "zz", "x"   # `keeps` does NOT match the specifier, so it survives
msg = "M1 through a variable %d"
print(msg)                                          # the half the runtime output scan covers
print("M2 opaque table %d".translate(tbl))          # translate() could map % to anything
print("M3 editing with a NAME argument %d".replace(keeps, new))  # cannot prove untouched
